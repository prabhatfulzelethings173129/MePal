# MePal server-side configuration. Copy this file to web/.env.local and fill in real values.
# NEVER commit .env.local. This example file is safe to commit.

# PayPal SANDBOX credentials: developer.paypal.com > Apps & Credentials > Sandbox > Create App.
# The app talks ONLY to https://api-m.sandbox.paypal.com (hard-coded).
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here

# Base URL PayPal redirects back to after approval (no trailing slash).
APP_BASE_URL=http://localhost:3000

# HMAC secret for quote tokens and proof-receipt seals. Use any long random string.
# If unset it falls back to PAYPAL_CLIENT_SECRET; if both are missing, sealing is refused.
MEPAL_SIGNING_SECRET=change_me_to_a_long_random_string

# Optional AI (any OpenAI-compatible endpoint). Defaults target a local Ollama server.
# MePal is fully usable without it: every AI feature has a code fallback.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=ollama
